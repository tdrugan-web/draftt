{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftt.com/schema/flow-1.json",
  "title": "Draftt flow",
  "description": "A Draftt flow, spec version 1. See docs/FLOW-SPEC.md. Cross-file checks (skills exist, artifact types registered, reference order) are done by scripts/validate_flows.py, not this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "spec", "version", "title", "summary", "audience", "entry", "steps", "outputs"],
  "properties": {
    "id": { "$ref": "#/$defs/kebab" },
    "spec": { "const": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["pm", "ux", "trio"] }
    },
    "estimate": { "type": "string", "maxLength": 30 },
    "entry": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entryInput" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ref" }
    }
  },
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "ref": {
      "type": "string",
      "pattern": "^(entry|steps|workspace)\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "checkpoint": { "enum": ["none", "review", "approve"] },
    "condition": { "type": "string", "minLength": 1, "maxLength": 200 },
    "entryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "enum": ["text", "long-text", "file", "files", "choice"] },
        "required": { "type": "boolean", "default": false },
        "help": { "type": "string", "maxLength": 160 },
        "default": { "type": "string" },
        "accept": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["transcript", "doc", "screenshot"] }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "$ref": "#/$defs/kebab" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "required": ["options"] },
          "else": { "not": { "required": ["options"] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["file", "files"] } } },
          "else": { "not": { "required": ["accept"] } }
        }
      ]
    },
    "skillStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "title", "uses", "produces"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "skill": { "$ref": "#/$defs/kebab" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "uses": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "produces": { "$ref": "#/$defs/kebab" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "optional": { "type": "boolean", "default": false },
        "when": { "$ref": "#/$defs/condition" },
        "instructions": { "type": "string", "maxLength": 300 }
      }
    },
    "parallelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "parallel"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "parallel": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/skillStep" }
        },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "optional": { "type": "boolean", "default": false },
        "when": { "$ref": "#/$defs/condition" }
      }
    },
    "branchStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "branch"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "branch": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "steps"],
            "properties": {
              "id": { "$ref": "#/$defs/kebab" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "when": { "$ref": "#/$defs/condition" },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/skillStep" }
              }
            }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/skillStep" },
        { "$ref": "#/$defs/parallelStep" },
        { "$ref": "#/$defs/branchStep" }
      ]
    }
  }
}
