{
  "description": "Loads the team's draftt.config.md into the session so every Draftt skill adapts to the team.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/load-team-context.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
